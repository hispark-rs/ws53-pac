          <fields>
            <field>
              <name>LOCKED</name>
              <description>0 unlocked, 1 locked; not the last written key</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LOCK_COMMAND</name>
          <description>LOCK_COMMAND</description>
          <alternateRegister>LOCK_STATUS</alternateRegister>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <fields>
            <field>
              <name>KEY</name>
              <description>0x5A5A5A5A unlocks; any other value locks</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WDT_LOAD</name>
          <description>WDT_LOAD</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>WDT_LOAD</name>
              <description>Load count value (24-bit, low 8 bits reserved)</description>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WDT_RESTART</name>
          <description>WDT_RESTART</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <fields>
            <field>
              <name>WDT_RESTART</name>
              <description>SDK kick writes 0x5A5A5A5A; other keys have contradictory SDK comments and are not specified</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
              <writeConstraint>
                <range>
                  <minimum>1515870810</minimum>
                  <maximum>1515870810</maximum>
                </range>
              </writeConstraint>
            </field>
          </fields>
        </register>
        <register>
          <name>WDT_EOI</name>
          <description>WDT_EOI</description>
          <addressOffset>0xC</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <readAction>modifyExternal</readAction>
          <fields>
            <field>
              <name>WDT_EOI</name>
              <description>Read returns zero and clears interrupt per SDK register comment; SDK clear helper reads then writes 1, independent write-only clear behavior unverified</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <readAction>modifyExternal</readAction>
            </field>
          </fields>
        </register>
        <register>
          <name>WDT_CR</name>
          <description>WDT_CR</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>WDT_EN</name>
              <description>Watchdog enable: 0=disabled; 1=enabled</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RST_EN</name>
              <description>Reset enable: 0=no reset on timeout; 1=reset on timeout</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RST_PL</name>
              <description>Reset pulse length: 000=2 clocks; up to 111=256 clocks</description>
              <bitOffset>3</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>WDT_IMSK</name>
              <description>Interrupt mask: 0=unmasked; 1=masked</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>WDT_MODE</name>
              <description>0 reset on first expiry interrupt, 1 reset on second expiry interrupt; reset still gated by RST_EN</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ResetOnFirst</name>
                  <description>Reset on first expiry interrupt when RST_EN is set</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ResetOnSecond</name>
                  <description>Reset on second expiry interrupt when RST_EN is set</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>WDT_CNT</name>
